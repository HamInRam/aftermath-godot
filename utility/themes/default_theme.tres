[gd_resource type="Theme" load_steps=3 format=3]

[sub_resource type="SystemFont" id="SystemFont_pixel"]
font_names = PackedStringArray("Menlo", "Monaco", "Courier New")
font_weight = 700
allow_system_fallback = true

[sub_resource type="StyleBoxFlat" id="StyleBox_panel"]
bg_color = Color(0.035, 0.02, 0.045, 0.88)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.62, 0.18, 0.42, 0.75)
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_right = 1
corner_radius_bottom_left = 1

[resource]
default_font = SubResource("SystemFont_pixel")
default_font_size = 6
Label/colors/font_color = Color(0.956863, 0.929412, 0.94902, 1)
Label/colors/font_outline_color = Color(0.0352941, 0.0156863, 0.0431373, 0.95)
Label/constants/outline_size = 1
Panel/styles/panel = SubResource("StyleBox_panel")

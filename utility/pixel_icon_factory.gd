static var _cache: Dictionary = {}

static func clear_cache() -> void:
	_cache.clear()

static func make(kind: String, color := Color("f4edf2")) -> Texture2D:
	var cache_key := "%s:%s" % [kind, color.to_html()]
	if _cache.has(cache_key): return _cache[cache_key]
	var image := Image.create(8, 8, false, Image.FORMAT_RGBA8)
	image.fill(Color.TRANSPARENT)
	var pattern: Array = PATTERNS.get(kind, PATTERNS.interact)
	for y in range(8):
		var row := str(pattern[y])
		for x in range(8):
			if row[x] == "#": image.set_pixel(x, y, color)
	var texture := ImageTexture.create_from_image(image)
	_cache[cache_key] = texture
	return texture

static func assign(button: Button, kind: String, color := Color("f4edf2")) -> void:
	button.icon = make(kind, color)
	button.expand_icon = false
	button.alignment = HORIZONTAL_ALIGNMENT_LEFT

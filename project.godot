; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AFTERMATH Prototype"
run/main_scene="res://scenes/ui/title_menu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.035, 0.02, 0.045, 1)

[autoload]

Events="*res://utility/events.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://utility/themes/default_theme.tres"
theme/default_font_antialiasing=0
theme/default_font_generate_mipmaps=false
theme/default_font_multichannel_signed_distance_field=false


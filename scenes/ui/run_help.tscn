[node name="Body" type="Label" parent="Panel/Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 7
autowrap_mode = 2
text = "MOVE / AIM\nWASD moves. Mouse aims. Shift looks farther.\n\nBLOOD FIRE\nA new run starts with full blood. Left click fires using the equipped weapon's blood cost. No magazines or reloads. Different weapon classes spend different amounts. Empty blood means no shot. Q throws your gun; E picks one up.\n\nSIPHON\nHold right mouse to sweep blood from an 90-degree forward cone up to 224 pixels away. A 48-pixel circle also collects behind you. Walls block suction. Near blood arrives faster; the red cursor halo means you are absorbing. You can move and fire throughout. Blood ground grants +30% speed. Gray striped pollution slows 40%, blocks roll starts and cannot be absorbed; fresh blood erases it.\n\nROLL\nSpace rolls in your movement direction, or toward your aim when stationary. The first 0.18 seconds are invulnerable; recovery is vulnerable. Rolling does not spend blood. Starting on blood increases roll speed by 35% for that roll, without extending invulnerability. You cannot shoot during the 0.28-second roll.\n\nEQUIPMENT\nQ throws your gun. E picks up a weapon. Blood skills, healing and Focus are disabled in this mode.\n\nTHE RUN\nClear rooms and descend through six venues. Health, armor and blood carry between floors.\n\nDEATH / RETRY\nR retries the same floor with its entry resources and loadout. Escape pauses.\n\nACCESSIBILITY\nAdjust shake, flashes, Focus effects and aim assistance in Settings."

[node name="Back" type="Button" parent="Panel/Layout"]
layout_mode = 2

anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.025, 0.025, 0.025, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 18.0
offset_top = 8.0
offset_right = -18.0
offset_bottom = -8.0

[node name="Layout" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Panel/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 9
text = "SURVIVE THE DESCENT"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Panel/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Body" type="Label" parent="Panel/Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 7
autowrap_mode = 2
text = "MOVE / AIM\nWASD moves. Mouse aims. Shift looks farther.\n\nFIRE / RELOAD\nLeft click fires magazine ammunition. R reloads from your reserves. A fresh click with an empty magazine also reloads if reserves remain. Q throws your gun; E picks one up.\n\nSIPHON / BLOOD RAGE\nStart with an empty blood meter. Hold right mouse to siphon a 90-degree forward cone up to 224 pixels away, plus a 48-pixel circle around you. Walls block suction. You can move and fire while siphoning.\n\nAt 100%, Blood Rage activates automatically: red body aura, +25% movement, unlimited crimson rounds with +65% damage and stronger penetration and blood spray. Nearby blood is automatically absorbed within 56 pixels, without holding RMB. Blood drains faster than it can refill. At 0%, rage ends and your stored magazine and reserves return unchanged.\n\nROLL\nSpace rolls toward movement, or toward aim when stationary. The first 0.18 seconds are invulnerable; recovery is vulnerable. Blood terrain increases roll speed by 35% without extending invulnerability. You cannot shoot during the 0.28-second roll.\n\nTHE RUN\nClear rooms and descend through six venues. Health, armor, ammunition and blood/rage state carry between floors.\n\nDEATH / RETRY\nAfter death, R retries the same floor with its entry resources and loadout. Escape pauses.\n\nACCESSIBILITY\nAdjust shake, flashes and aim assistance in Settings."

[node name="Back" type="Button" parent="Panel/Layout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 16)
theme_override_font_sizes/font_size = 7
text = "BACK"
